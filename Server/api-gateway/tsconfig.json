{
  "compilerOptions": {
    "target": "es6",                               
    "module": "commonjs",     
    "outDir": "./dist",
    "rootDir": "./src",                       
    "esModuleInterop": true,      
    "moduleResolution": "node",
    "forceConsistentCasingInFileNames": true,         
    "strict": true,                                
    "skipLibCheck": true,   
    "typeRoots": ["./node_modules/@types", "./src/types"]                        
},
  "include": ["src/**/*"]
}
